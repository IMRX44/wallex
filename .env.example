# Copy to .env (never commit it) or set these as environment variables on Liara.
PISHRO_MODE=paper                 # paper = shadow test with live prices; live = real orders
LIVE_CONFIRM=                     # must be I_UNDERSTAND for live mode
WALLEX_API_KEY=                   # Wallex API key of the challenge account (trade permission, NO withdrawal)
LLM_BASE_URL=                     # Liara AI service base URL, e.g. https://ai.liara.ir/api/v1/<service-id>
LLM_API_KEY=                      # Liara AI service key
LLM_MODEL=anthropic/claude-opus-5.5
CHALLENGE_END=2026-10-26T23:50:00+03:30
DASHBOARD_PASSWORD=               # needed for dashboard control buttons
BALE_BOT_TOKEN=                   # optional notifications (Bale works from Iranian servers)
BALE_CHAT_ID=
